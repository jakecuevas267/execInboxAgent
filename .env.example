# Copy to .env and fill in.

ANTHROPIC_API_KEY=sk-ant-...

# Agent model (flip to claude-sonnet-5 for cheaper eval runs)
AGENT_MODEL=claude-opus-5

# LangSmith tracing (optional but recommended - traces every agent run)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=exec-inbox-agent
